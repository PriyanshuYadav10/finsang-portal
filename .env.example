# Copy to .env and export these (e.g. `set -a; source .env; set +a`) before `npm start`.
PORT=3000
BASE_URL=http://localhost:3000
# Where the SQLite database and uploaded files are stored (default: ./data)
DATA_DIR=./data
# First-run admin account (only used when no admin exists yet)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-long-password
ADMIN_NAME=Administrator
# Set to 1 when serving over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=0
# Set to 1 when behind a reverse proxy (nginx, Cloudflare...) so rate limiting sees real client IPs
TRUST_PROXY=
# Set to 1 on first start to also load demo students, trainer and sample activity
SEED_DEMO=0
