{
  "name": "finsang-portal",
  "version": "1.0.0",
  "description": "Finsang Skill Program portal: public site, student portal, trainer panel and admin console.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed:demo": "node server/seed.js --demo",
    "reset": "node server/seed.js --reset",
    "test": "node server/smoke-test.js",
    "build:php": "bash scripts/build-php.sh",
    "export:seed": "node scripts/export-seed.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
